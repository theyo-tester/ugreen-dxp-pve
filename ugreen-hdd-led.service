[Unit]
Description=UGREEN HDD LED Controller
After=multi-user.target
ConditionPathExists=/sys/class/leds/ugreen:white:disk1/brightness

[Service]
Type=simple
EnvironmentFile=-/etc/ugreen/ugreen-leds.env
ExecStart=/usr/local/bin/ugreen-hdd-led.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
