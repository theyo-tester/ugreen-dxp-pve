# /etc/ugreen/ugreen-leds.env

# Brightness levels (0-255)
BRIGHTNESS_SLEEP=5
BRIGHTNESS_ACTIVE=20
BRIGHTNESS_FULL=255

# Minutes of zero IO activity before drive LED drops to sleep brightness
IDLE_MINUTES=15

# Color configuration by drive type
HDD_COLOR="white"
SSD_COLOR="amber"
DEGRADED_COLOR="red"

# Polling frequency in seconds (Reading /sys/block/*/stat does NOT wake up disks)
POLL_INTERVAL=5
