# Central UGREEN LED Configuration

# Disk LED Colors
HDD_COLOR="white"
SSD_COLOR="blue"
DEGRADED_COLOR="red"

# Network LED Settings
NET_INTERFACE="vmbr0"
NET_COLOR="white"

# Global Brightness Defaults
BRIGHTNESS_SLEEP=5
BRIGHTNESS_ACTIVE=20
BRIGHTNESS_FULL=255
# Minutes of zero IO activity before drive LED drops to sleep brightness
IDLE_MINUTES=15
# Polling frequency in seconds (Reading /sys/block/*/stat does NOT wake up disks)
POLL_INTERVAL=5
# There are no dedicated NVMe LEDs. Each detected NVMe (there can be several)
# shares the LED of one HDD bay (1st NVMe -> disk1, 2nd -> disk2, etc.), and
# color priority decides which drive's activity wins on a shared LED.
# SCSI host number -> LED slot offset used for SATA disk mapping (host 0 =>
# disk1 by default). This mapping is model-dependent; verify with:
#   lsblk -S -x hctl -o name,hctl,serial
# and adjust if your first SATA bay does not correspond to host 0.
HCTL_SLOT_OFFSET=1
# Set to 1 to log per-device IO deltas and computed slot/priority every poll (for troubleshooting).
HDD_LED_DEBUG=0
# On/off durations (ms) for the hardware blink used while a slot is actively transferring data.
BLINK_ON_MS=150
BLINK_OFF_MS=150
# Fire activity blinks the instant a real IO completes (via bpftrace tracepoints)
# instead of waiting for the next poll. Falls back to poll-driven flashing if
# bpftrace isn't installed. Set to 0 to always use poll-driven flashing.
BPFTRACE_ENABLED=1